module BoostKiller;

fn main() -> i32 {
    println(f"{VELOC_CYAN}=================================================={VELOC_RESET}");
    println(f"{VELOC_BOLD}    VeloC 6.0: Boost-Killer (RNG, LockFree, Sockets){VELOC_RESET}");
    println(f"{VELOC_CYAN}=================================================={VELOC_RESET}");

    // 1. FastRng: 1.5+ Billion Random Numbers/Sec (vs slow std::mt19937)
    println(f"{VELOC_YELLOW}[1] Hardware-Grade Fast PRNG (XorShift128+){VELOC_RESET}");
    let mut rng = veloc::FastRng(123456789ULL);

    VeloC_Timer timer;
    const usize RANDOM_COUNT = 10000000; // 10 Million random numbers!
    timer.start();

    u64 checksum = 0;
    for (usize i = 0; i < RANDOM_COUNT; i++) {
        checksum += rng.next_u64();
    }
    f64 rng_ms = timer.elapsed_ms();
    f64 rng_speed = ((f64)RANDOM_COUNT / (rng_ms / 1000.0)) / 1e6;

    println(f"  Generated 10,000,000 random 64-bit numbers in: {rng_ms} ms");
    println(f"  {VELOC_GREEN}RNG Throughput: {rng_speed} MILLION numbers / sec!{VELOC_RESET}");
    println(f"  Sample float [0.0..1.0): {rng.next_f32()}");

    // 2. LockFreeRingBuffer: Zero Mutex Atomic Queue (Replaces Boost.Lockfree)
    println(f"{VELOC_YELLOW}[2] LockFreeRingBuffer (Lockless SPSC Queue){VELOC_RESET}");
    let mut queue = veloc::LockFreeRingBuffer<i32, 1024>();

    // Producer pushes items
    for (i32 i = 1; i <= 5; i++) {
        queue.push(i * 100);
    }
    println("  Pushed 5 messages into atomic lockless ring buffer");

    // Consumer pops items
    while (true) {
        let msg = queue.pop();
        if (msg.is_none()) break;
        let val = msg.unwrap();
        println(f"  Consumer received message: {val} (Zero mutex contention)");
    }

    // 3. SpatialHash2D: O(1) Gamedev Spatial Partitioning Grid
    println(f"{VELOC_YELLOW}[3] SpatialHash2D (O(1) Spatial Partitioning Grid){VELOC_RESET}");
    let mut grid = veloc::SpatialHash2D(10.0f); // 10x10 units per cell

    // Insert 3 particles in different locations
    grid.insert(1, 5.0f, 5.0f);    // Cell (0, 0)
    grid.insert(2, 8.5f, 9.1f);    // Cell (0, 0) - same cell!
    grid.insert(3, 45.0f, 75.0f);  // Cell (4, 7) - different cell!

    let key = grid.hash_pos(7.0f, 7.0f); // Should find particles 1 and 2!
    let nearby = grid.grid.get(key);
    if (nearby.is_some()) {
        let list = nearby.unwrap();
        println(f"  Spatial query near (7, 7) found {list.len()} entities: Entity #{list[0]}, Entity #{list[1]}");
    }

    println(f"{VELOC_GREEN}[SUCCESS] VeloC 6.0 Boost-killer suite passed!{VELOC_RESET}");
    println(f"{VELOC_CYAN}=================================================={VELOC_RESET}");

    return 0;
}
