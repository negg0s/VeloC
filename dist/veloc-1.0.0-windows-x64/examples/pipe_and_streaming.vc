// ============================================================================
// VeloC 3.5: Pipe Operator |>, StackString, Mat4 3D, and Streaming Memory
// ============================================================================

fn square(f32 x) -> f32 {
    return x * x;
}

fn add_val(f32 x, f32 amount) -> f32 {
    return x + amount;
}

fn multiply_val(f32 x, f32 factor) -> f32 {
    return x * factor;
}

int main() {
    println("===============================================================");
    println("      VeloC 3.5: Functional Pipelining & High-Speed Engine     ");
    println("===============================================================");

    // 1. Pipe Operator (|>) - Reddit & Functional Programming Dream in C++
    let f32 input = 4.0f;
    // 4.0 |> square -> 16.0 |> add_val(4.0) -> 20.0 |> multiply_val(3.0) -> 60.0
    let f32 piped_result = input |> square |> add_val(4.0f) |> multiply_val(3.0f);
    println(f"1. Pipe Operator Chaining: 4.0 |> square |> add(4.0) |> mul(3.0) = {piped_result}");

    // 2. StackString<64>: Zero-Allocation, 100% Stack String
    println("\n2. StackString<64> (Zero Heap Allocations):");
    StackString<64> s1("Velocity");
    s1.append(" + C = ");
    s1.append("VeloC Ultra!");
    println(f"   StackString: '{s1.c_str()}', length = {s1.len()}");

    // 3. Mat4: Full AVX/FMA 4x4 Matrix for 3D Graphics & Physics
    println("\n3. Mat4 3D Transformation (SIMD FMA):");
    Mat4 trans = Mat4::translation(10.0f, 20.0f, 30.0f);
    Mat4 scale = Mat4::scaling(2.0f, 2.0f, 2.0f);
    Mat4 model_mat = trans * scale;

    Vec4 local_pos(1.0f, 2.0f, 3.0f, 1.0f);
    Vec4 world_pos = model_mat.transform(local_pos);
    println(f"   Local:  ({local_pos.x}, {local_pos.y}, {local_pos.z})");
    println(f"   World:  ({world_pos.x}, {world_pos.y}, {world_pos.z})");

    // 4. Binary Serializer (ByteWriter & ByteReader)
    println("\n4. Zero-Copy Binary Packet Serializer:");
    ByteWriter<128> writer;
    writer.write_u8(0xFF);
    writer.write_u32(1337);
    writer.write_f32(3.14159f);

    ByteReader reader(writer.data(), writer.len());
    let magic = reader.read_u8().unwrap();
    let port  = reader.read_u32().unwrap();
    let pi    = reader.read_f32().unwrap();
    println(f"   Decoded packet: magic={(u32)magic}, port={port}, pi={pi}");

    // 5. AVX2 Non-Temporal Streaming Memory Bandwidth Benchmark
    println("\n5. AVX2 Non-Temporal Streaming Benchmark (Bypassing CPU Cache):");
    const usize BUFFER_SIZE = 16 * 1024 * 1024; // 16 MB Buffer
    u8* stream_buf_src = (u8*)veloc_aligned_alloc(32, BUFFER_SIZE);
    u8* stream_buf_dst = (u8*)veloc_aligned_alloc(32, BUFFER_SIZE);
    defer veloc_aligned_free(stream_buf_src);
    defer veloc_aligned_free(stream_buf_dst);

    memset(stream_buf_src, 0xAA, BUFFER_SIZE);

    bench "AVX2 Streaming Zero (16 MB)" {
        veloc::fast_zero_mem(stream_buf_dst, BUFFER_SIZE);
    }

    bench "AVX2 Streaming Copy (16 MB)" {
        veloc::fast_copy_mem(stream_buf_dst, stream_buf_src, BUFFER_SIZE);
    }

    println("===============================================================");
    println("      All VeloC 3.5 Engine Subsystems Passed!                  ");
    println("===============================================================");
    return 0;
}
