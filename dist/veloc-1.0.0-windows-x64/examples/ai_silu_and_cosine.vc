// VeloC 7.5: AVX2 SIMD SiLU, SIMD Cosine Similarity & while let pattern matching
fn test_simd_silu() -> void {
    println("--- 1. Testing AVX2 SIMD SiLU / Swish Activation (LLaMA 2/3) ---");
    let count: usize = 1000000;
    let data = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    defer veloc_aligned_free(data);

    for (let i in range(0, count as i64, 1)) {
        data[i] = ((i % 100) as f32) * 0.1f - 5.0f;
    }

    bench "AVX2 SIMD SiLU (1M floats)" {
        simd_silu(data, count);
    }

    println(f"Sample data[0] = {data[0]}, data[50] = {data[50]}");
}

fn test_simd_cosine_similarity() -> void {
    println("--- 2. Testing AVX2 SIMD Cosine Similarity (Vector Databases & AI Search) ---");
    let dim: usize = 4096; // 4k embedding dimension (LLaMA 3 embedding size)
    let vec_a = (f32*)veloc_aligned_alloc(32, sizeof(f32) * dim);
    let vec_b = (f32*)veloc_aligned_alloc(32, sizeof(f32) * dim);
    defer veloc_aligned_free(vec_a);
    defer veloc_aligned_free(vec_b);

    for (let i in range(0, dim as i64, 1)) {
        vec_a[i] = 1.0f;
        vec_b[i] = 1.0f;
    }

    let iterations: usize = 100000;
    let mut last_sim: f32 = 0.0f;

    bench "AVX2 SIMD Cosine Similarity (100k queries, dim=4096)" {
        for (let i in range(0, iterations as i64, 1)) {
            last_sim = simd_cosine_similarity(vec_a, vec_b, dim);
        }
    }

    println(f"Identical vectors similarity = {last_sim} (Expected: 1.0)");
    assert_true(last_sim > 0.999f && last_sim < 1.001f);
}

fn test_while_let_pattern_matching() -> void {
    println("--- 3. Testing Rust-style while let Some(...) loop ---");
    let queue = FixedQueue<i32, 8>();
    let mut q = queue;
    q.push(10);
    q.push(20);
    q.push(30);

    let mut sum: i32 = 0;
    let mut count: usize = 0;

    while let Some(item) = q.pop() {
        println(f"Popped item from queue: {item}");
        sum += item;
        count++;
    }

    println(f"Total sum = {sum}, count = {count}");
    assert_eq(sum, 60);
    assert_eq(count, 3);
    assert_true(q.is_empty());
}

int main() {
    test_simd_silu();
    test_simd_cosine_similarity();
    test_while_let_pattern_matching();
    println("ALL VELOC 7.5 CHECKS PASSED WITH FLYING COLORS!");
    return 0;
}
