module CommunityFeatures;

// 1. Modern function syntax
fn divide(f32 a, f32 b) -> Result<f32, const char*> {
    if (b == 0.0f) {
        return Result<f32, const char*>::Err("Division by zero!");
    }
    return Result<f32, const char*>::Ok(a / b);
}

fn find_item(i32 target) -> Option<i32> {
    if (target > 0) {
        return Option<i32>::Some(target * 10);
    }
    return Option<i32>::None();
}

// 2. Built-in Tests (Directly inside language, like Zig & Rust!)
test "math and let variables" {
    let a = 10;
    let mut b = 20;
    b += 5;
    assert_eq(a + b, 35);
}

test "result type and error handling" {
    let ok_res = divide(100.0f, 4.0f);
    assert_true(ok_res.is_ok());
    assert_eq((i32)ok_res.unwrap(), 25);

    let err_res = divide(10.0f, 0.0f);
    assert_true(err_res.is_err());
    assert_eq(err_res.unwrap_or(-1.0f), -1.0f);
}

test "option type" {
    let opt_some = find_item(5);
    assert_true(opt_some.is_some());
    assert_eq(opt_some.unwrap(), 50);

    let opt_none = find_item(-3);
    assert_true(opt_none.is_none());
    assert_eq(opt_none.unwrap_or(999), 999);
}

test "safe slices" {
    i32 numbers[5] = {10, 20, 30, 40, 50};
    let mut s = Slice<i32>::from_array(numbers, 5);
    assert_eq(s[0], 10);
    assert_eq(s[4], 50);
    s[2] = 99;
    assert_eq(s[2], 99);
}

// 3. Regular main program execution
fn main() -> i32 {
    println("==================================================");
    println("     VeloC 2.0: Massive Reddit Community Update   ");
    println("==================================================");

    // String interpolation (No format string mismatch bugs!)
    let name = "Developer";
    let speedup = 21.7;
    println(f"Hello {name}! VeloC speedup is {speedup}x over standard C++!");

    // Result<T, E>
    let res = divide(42.0f, 2.0f);
    if (res.is_ok()) {
        let val = res.unwrap();
        println(f"Division Result: 42 / 2 = {val}");
    }

    // Subprocess execution (Top Reddit C++ complaint solved!)
    println("Spawning native subprocess from VeloC...");
    veloc_exec("echo [Subprocess Output]: Hello from Windows shell!");

    println("Community features demonstration complete!");
    println("==================================================");

    return 0;
}
