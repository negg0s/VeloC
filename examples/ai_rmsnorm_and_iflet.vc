// VeloC 7.0: AVX2 SIMD RMSNorm, Parallel Reduce & Rust-style if let pattern matching
fn test_simd_rms_norm() -> void {
    println("--- 1. Testing AVX2 SIMD RMSNorm (LLaMA 3 / Gemma Normalization) ---");
    let count: usize = 1000000;
    let data = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    let weight = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    defer veloc_aligned_free(data);
    defer veloc_aligned_free(weight);

    for (let i in range(0, count as i64, 1)) {
        data[i] = ((i % 100) as f32) * 0.1f - 5.0f;
        weight[i] = 1.0f;
    }

    bench "AVX2 SIMD RMSNorm (1M floats)" {
        simd_rms_norm(data, weight, count, 1e-5f);
    }

    println(f"Normalized data[0] = {data[0]}, data[50] = {data[50]}");
}

fn test_parallel_reduce() -> void {
    println("--- 2. Testing parallel_reduce across 12 hardware threads ---");
    let count: usize = 10000000; // 10 Million numbers
    let arr = (u64*)veloc_aligned_alloc(32, sizeof(u64) * count);
    defer veloc_aligned_free(arr);

    for (let i in range(0, count as i64, 1)) {
        arr[i] = 1;
    }

    let mut total: u64 = 0;
    bench "parallel_reduce sum (10M elements, 12 threads)" {
        total = parallel_reduce(arr, count, 0ULL, |acc, val| => acc + val);
    }

    println(f"Parallel sum of 10M ones = {total} (Expected: 10000000)");
    assert_eq(total, 10000000ULL);
}

fn test_if_let_pattern_matching() -> void {
    println("--- 3. Testing Rust-style if let Some / Ok pattern matching ---");
    let opt_some = Option<i32>::Some(42);
    let opt_none = Option<i32>::None();

    let mut visited_some = false;
    if let Some(val) = opt_some {
        println(f"Successfully matched Some with value: {val}");
        assert_eq(val, 42);
        visited_some = true;
    }
    assert_true(visited_some);

    let mut visited_none = false;
    if let Some(val) = opt_none {
        println("ERROR: Should not enter here!");
        assert_true(false);
    } else {
        println("Successfully bypassed None in if let");
        visited_none = true;
    }
    assert_true(visited_none);

    let res_ok = Result<const char*, int>::Ok("VeloC Ultra Speed");
    let mut visited_ok = false;
    if let Ok(msg) = res_ok {
        println(f"Successfully matched Ok with message: {msg}");
        visited_ok = true;
    }
    assert_true(visited_ok);
}

int main() {
    test_simd_rms_norm();
    test_parallel_reduce();
    test_if_let_pattern_matching();
    println("ALL VELOC 7.0 CHECKS COMPLETED WITH 100 PERCENT SUCCESS!");
    return 0;
}
