module ReflectionAnd3D;

soa struct Hero {
    f32 hp;
    f32 mana;
    f32 armor;
    f32 speed;
};

fn main() -> i32 {
    println(f"{VELOC_CYAN}=================================================={VELOC_RESET}");
    println(f"{VELOC_BOLD}   VeloC 4.0: Reflection, 3D SIMD & Memory Tracking{VELOC_RESET}");
    println(f"{VELOC_CYAN}=================================================={VELOC_RESET}");

    // 1. Built-in Compile-Time Reflection & JSON (Top Reddit Request!)
    println(f"{VELOC_YELLOW}[1] Compile-Time Reflection & Auto-JSON{VELOC_RESET}");
    let mut heroes = Hero_SoA::create(10);
    defer heroes.destroy();

    heroes.push(100.0f, 50.0f, 15.0f, 7.5f);
    heroes.push(250.0f, 10.0f, 40.0f, 5.0f);

    println(f"  Type Name:    {Hero_SoA::type_name()}");
    println(f"  Field Count:  {Hero_SoA::field_count()} fields");
    println(f"  Hero 0 JSON:  {heroes.to_json(0)}");
    println(f"  Hero 1 JSON:  {heroes.to_json(1)}");

    // 2. Hardware 3D Vector Math (SIMD Vec3)
    println(f"{VELOC_YELLOW}[2] 128-bit SIMD 3D Vector Math (Vec3){VELOC_RESET}");
    let v1 = Vec3(1.0f, 2.0f, 3.0f);
    let v2 = Vec3(4.0f, 5.0f, 6.0f);

    let v_add = v1 + v2;
    let v_sub = v2 - v1;
    let v_dot = v1.dot(v2);
    let v_cross = v1.cross(v2);
    let v_norm = v1.normalized();

    println(f"  v1 + v2:      ({v_add.x}, {v_add.y}, {v_add.z})");
    println(f"  v2 - v1:      ({v_sub.x}, {v_sub.y}, {v_sub.z})");
    println(f"  Dot product:  {v_dot}");
    println(f"  Cross prod:   ({v_cross.x}, {v_cross.y}, {v_cross.z})");
    println(f"  v1 Normalized:({v_norm.x}, {v_norm.y}, {v_norm.z}) [length = {v_norm.length()}]");

    // 3. Memory Profiler & Tracking
    println(f"{VELOC_YELLOW}[3] Built-in Memory Telemetry Tracker{VELOC_RESET}");
    veloc::MemoryTracker::record_alloc(1024 * 64); // 64 KB
    veloc::MemoryTracker::record_alloc(1024 * 128); // 128 KB
    veloc::MemoryTracker::print_report();
    veloc::MemoryTracker::record_free(1024 * 64);
    veloc::MemoryTracker::print_report();

    println(f"{VELOC_GREEN}[SUCCESS] All VeloC 4.0 features operational!{VELOC_RESET}");
    println(f"{VELOC_CYAN}=================================================={VELOC_RESET}");

    return 0;
}
