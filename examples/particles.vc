// VeloC Example: 5 Million Particles Simulation
// Demonstrates SoA (Struct-of-Arrays), noalias SIMD vectorization, defer, and Arena

module Simulation;

soa struct Particle {
    f32 x;
    f32 y;
    f32 vx;
    f32 vy;
};

// Vectorized physics update: noalias informs compiler pointers cannot overlap
VELOC_INLINE void update_particles(f32* noalias x, f32* noalias y, 
                                  const f32* noalias vx, const f32* noalias vy, 
                                  usize count, f32 dt) {
    #pragma clang loop vectorize(enable)
    for (usize i = 0; i < count; i++) {
        x[i] += vx[i] * dt;
        y[i] += vy[i] * dt;
    }
}

int main() {
    println("==================================================");
    println("           VeloC High-Performance Engine          ");
    println("==================================================");

    const usize NUM_PARTICLES = 5000000; // 5 Million particles!
    println("Initializing %llu particles using SoA SIMD layout...", (unsigned long long)NUM_PARTICLES);

    // Create SoA particle storage with 32-byte SIMD alignment
    Particle_SoA particles = Particle_SoA::create(NUM_PARTICLES);
    defer particles.destroy(); // Zero-cost defer ensures automatic cleanup

    // Fill particles
    for (usize i = 0; i < NUM_PARTICLES; i++) {
        particles.x[i] = (f32)(i % 100);
        particles.y[i] = (f32)(i % 200);
        particles.vx[i] = 1.5f;
        particles.vy[i] = -0.5f;
    }
    particles.count = NUM_PARTICLES;

    // Test bump Arena Allocator
    VeloC_Arena arena = VeloC_Arena::create(16 * 1024 * 1024); // 16 MB arena
    defer arena.destroy();
    f32* scratch = arena.alloc_array<f32>(100000);
    scratch[0] = 42.0f;
    println("Arena allocation succeeded: scratch[0] = %.1f (zero-lock instant allocation)", scratch[0]);

    // Benchmark physics step
    VeloC_Timer timer;
    const int STEPS = 20;
    println("Running %d physics simulation steps...", STEPS);

    timer.start();
    for (int step = 0; step < STEPS; step++) {
        update_particles(particles.x, particles.y, particles.vx, particles.vy, particles.count, 0.016f);
    }
    f64 total_ms = timer.elapsed_ms();
    f64 per_step_ms = total_ms / STEPS;
    f64 particles_per_sec = ((f64)NUM_PARTICLES * STEPS) / (total_ms / 1000.0) / 1e6;

    println("Done!");
    println("Total Time for %d steps: %.2f ms", STEPS, total_ms);
    println("Average Time per step:    %.3f ms", per_step_ms);
    println("Throughput:               %.2f Million particles/sec", particles_per_sec);
    println("Sample Particle 0: pos = (%.2f, %.2f)", particles.x[0], particles.y[0]);
    println("Sample Particle 1000: pos = (%.2f, %.2f)", particles.x[1000], particles.y[1000]);
    println("==================================================");

    return 0;
}
