// VeloC 6.5: AI SIMD GeLU, Vectorized Lerp, Enumerate Loops & Struct Destructuring
fn test_simd_gelu() -> void {
    println("--- 1. Testing AVX2 SIMD GeLU (LLM/Transformer Activation) ---");
    let count: usize = 1000000;
    let data = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    defer veloc_aligned_free(data);

    for (let i in range(0, count as i64, 1)) {
        data[i] = ((i % 200) as f32) * 0.05f - 5.0f;
    }

    bench "AVX2 SIMD GeLU (1M floats)" {
        simd_gelu(data, count);
    }

    // Verify properties of GeLU: GeLU(0) == 0, GeLU(-inf) -> 0, GeLU(x) > 0 for x > 0
    println(f"Sample data[0] = {data[0]}, data[100] = {data[100]}");
}

fn test_simd_lerp() -> void {
    println("--- 2. Testing AVX2 SIMD Lerp (Linear Interpolation) ---");
    let count: usize = 1000000;
    let a = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    let b = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    let out = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    defer veloc_aligned_free(a);
    defer veloc_aligned_free(b);
    defer veloc_aligned_free(out);

    for (let i in range(0, count as i64, 1)) {
        a[i] = 10.0f;
        b[i] = 20.0f;
    }

    bench "AVX2 SIMD Lerp (1M floats, t=0.25)" {
        simd_lerp_array(out, a, b, 0.25f, count);
    }

    println(f"Interpolated out[0] = {out[0]} (Expected: 12.5)");
    assert_true(out[0] == 12.5f);
}

fn test_enumerate_loop() -> void {
    println("--- 3. Testing Python/Rust-style enumerate() loop ---");
    let numbers = SmallVec<i32, 8>();
    let mut num_vec = numbers;
    num_vec.push(100);
    num_vec.push(200);
    num_vec.push(300);

    for (let (idx, val) in enumerate(num_vec)) {
        println(f"Index: {idx}, Value: {val}");
        if (idx == 0) assert_eq(val, 100);
        if (idx == 1) assert_eq(val, 200);
        if (idx == 2) assert_eq(val, 300);
    }
}

int main() {
    test_simd_gelu();
    test_simd_lerp();
    test_enumerate_loop();
    println("ALL VELOC 6.5 SYSTEMS PASSED PERFECTLY!");
    return 0;
}
