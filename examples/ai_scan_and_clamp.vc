// VeloC 8.0: SIMD Prefix Sum, In-place SIMD Clamp & Integer Match Expressions
fn test_simd_prefix_sum() -> void {
    println("--- 1. Testing AVX2 SIMD Prefix Sum (Inclusive Scan) ---");
    let count: usize = 1000000;
    let in_arr = (u32*)veloc_aligned_alloc(32, sizeof(u32) * count);
    let out_arr = (u32*)veloc_aligned_alloc(32, sizeof(u32) * count);
    defer veloc_aligned_free(in_arr);
    defer veloc_aligned_free(out_arr);

    for (let i in range(0, count as i64, 1)) {
        in_arr[i] = 1;
    }

    bench "AVX2 SIMD Prefix Sum (1M u32)" {
        simd_prefix_sum_u32(out_arr, in_arr, count);
    }

    println(f"Sample out[0] = {out_arr[0]}, out[99] = {out_arr[99]}, out[999999] = {out_arr[999999]}");
    assert_eq(out_arr[0], 1);
    assert_eq(out_arr[99], 100);
    assert_eq(out_arr[999999], 1000000);
}

fn test_simd_clamp_array() -> void {
    println("--- 2. Testing AVX2 SIMD Clamp Array ---");
    let count: usize = 1000000;
    let data = (f32*)veloc_aligned_alloc(32, sizeof(f32) * count);
    defer veloc_aligned_free(data);

    for (let i in range(0, count as i64, 1)) {
        data[i] = ((i % 100) as f32) - 50.0f; // range [-50.0, 49.0]
    }

    bench "AVX2 SIMD Clamp Array (1M floats, [-10.0, 10.0])" {
        simd_clamp_array(data, count, -10.0f, 10.0f);
    }

    // Verify all clamped
    let mut all_valid = true;
    for (let i in range(0, count as i64, 1000)) {
        if (data[i] < -10.0f || data[i] > 10.0f) all_valid = false;
    }
    println(f"Clamped data[0] = {data[0]}, data[99] = {data[99]}");
    assert_true(all_valid);
}

fn test_integer_match() -> void {
    println("--- 3. Testing Integer Match Pattern Matching ---");
    let code: i32 = 200;
    let mut status = "Unknown";

    match (code) {
        200 => status = "OK";
        404 => status = "Not Found";
        500 => status = "Internal Server Error";
        _   => status = "Other";
    }

    println(f"HTTP {code} matched status: {status}");
    assert_true(strcmp(status, "OK") == 0);

    let error_code: i32 = 404;
    match (error_code) {
        200 => status = "OK";
        404 => status = "Not Found";
        _   => status = "Other";
    }
    println(f"HTTP {error_code} matched status: {status}");
    assert_true(strcmp(status, "Not Found") == 0);
}

int main() {
    test_simd_prefix_sum();
    test_simd_clamp_array();
    test_integer_match();
    println("ALL VELOC 8.0 ADVANCED TESTS COMPLETED PERFECTLY!");
    return 0;
}
