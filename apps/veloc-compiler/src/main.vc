module VelocCompiler;

#include <veloc.h>
#include <string>
#include <vector>
#include <unordered_map>
#include <chrono>

enum MicroOp {
    OP_CONST,
    OP_LOAD,
    OP_STORE,
    OP_ADD,
    OP_SUB,
    OP_MUL,
    OP_CMP_LT,
    OP_JMP,
    OP_JZ,
    OP_RET,
    OP_HALT
};

struct Instruction {
    MicroOp op;
    i64 imm;
    std::string name;
};

class MicroVm {
public:
    std::vector<Instruction> code;
    std::vector<i64> stack;
    std::unordered_map<std::string, i64> vars;

    void emit(MicroOp op, i64 imm = 0, const std::string& name = "") {
        code.push_back({op, imm, name});
    }

    i64 run(i64& cycles_executed) {
        stack.clear();
        stack.reserve(1024);
        i32 pc = 0;
        i32 n = (i32)code.size();
        cycles_executed = 0;

        while (pc < n) {
            cycles_executed++;
            const auto& inst = code[pc];
            switch (inst.op) {
                case OP_CONST:
                    stack.push_back(inst.imm);
                    pc++;
                    break;
                case OP_LOAD:
                    stack.push_back(vars[inst.name]);
                    pc++;
                    break;
                case OP_STORE: {
                    i64 val = stack.back();
                    stack.pop_back();
                    vars[inst.name] = val;
                    pc++;
                    break;
                }
                case OP_ADD: {
                    i64 b = stack.back(); stack.pop_back();
                    i64 a = stack.back(); stack.pop_back();
                    stack.push_back(a + b);
                    pc++;
                    break;
                }
                case OP_SUB: {
                    i64 b = stack.back(); stack.pop_back();
                    i64 a = stack.back(); stack.pop_back();
                    stack.push_back(a - b);
                    pc++;
                    break;
                }
                case OP_MUL: {
                    i64 b = stack.back(); stack.pop_back();
                    i64 a = stack.back(); stack.pop_back();
                    stack.push_back(a * b);
                    pc++;
                    break;
                }
                case OP_CMP_LT: {
                    i64 b = stack.back(); stack.pop_back();
                    i64 a = stack.back(); stack.pop_back();
                    stack.push_back(a < b ? 1 : 0);
                    pc++;
                    break;
                }
                case OP_JMP:
                    pc = (i32)inst.imm;
                    break;
                case OP_JZ: {
                    i64 cond = stack.back(); stack.pop_back();
                    if (cond == 0) {
                        pc = (i32)inst.imm;
                    } else {
                        pc++;
                    }
                    break;
                }
                case OP_RET:
                case OP_HALT:
                    return stack.empty() ? 0 : stack.back();
            }
        }
        return stack.empty() ? 0 : stack.back();
    }
};

// Optimizer: Constant Folder pass on bytecode sequence
void optimize_constant_folding(MicroVm& vm) {
    std::vector<Instruction> optimized;
    for (size_t i = 0; i < vm.code.size(); ++i) {
        // Look for pattern: OP_CONST a, OP_CONST b, OP_ADD -> OP_CONST (a+b)
        if (i + 2 < vm.code.size() &&
            vm.code[i].op == OP_CONST &&
            vm.code[i+1].op == OP_CONST) {
            if (vm.code[i+2].op == OP_ADD) {
                optimized.push_back({OP_CONST, vm.code[i].imm + vm.code[i+1].imm, ""});
                i += 2;
                continue;
            } else {
                if (vm.code[i+2].op == OP_MUL) {
                    optimized.push_back({OP_CONST, vm.code[i].imm * vm.code[i+1].imm, ""});
                    i += 2;
                    continue;
                }
            }
        }
        optimized.push_back(vm.code[i]);
    }
    vm.code = optimized;
}

fn main() -> i32 {
    printf("================================================================================\n");
    printf("    VeloC-Compiler: Micro-Language Lexer, Parser, Optimizer & Bytecode VM       \n");
    printf("================================================================================\n");

    // 1. Test Constant Folding
    MicroVm test_vm;
    // Expression: (10 + 20) * 3
    test_vm.emit(OP_CONST, 10);
    test_vm.emit(OP_CONST, 20);
    test_vm.emit(OP_ADD);
    test_vm.emit(OP_CONST, 3);
    test_vm.emit(OP_MUL);
    test_vm.emit(OP_HALT);

    printf("  - Initial bytecode size: %zu instructions\n", test_vm.code.size());
    optimize_constant_folding(test_vm);
    printf("  - After Constant Folding: %zu instructions\n", test_vm.code.size());

    i64 cycles = 0;
    i64 cf_result = test_vm.run(cycles);
    printf("  - Constant folded result: %lld (Expected 90, in %lld cycles)\n", cf_result, cycles);

    // 2. Compile and run Loop: Compute Sum 1..1,000,000
    // let sum = 0
    // let i = 1
    // while i <= 1000000:
    //     sum = sum + i
    //     i = i + 1
    MicroVm loop_vm;
    // 0: sum = 0
    loop_vm.emit(OP_CONST, 0);
    loop_vm.emit(OP_STORE, 0, "sum");
    // 2: i = 1
    loop_vm.emit(OP_CONST, 1);
    loop_vm.emit(OP_STORE, 0, "i");

    // Loop Header (PC = 4):
    // 4: load i
    loop_vm.emit(OP_LOAD, 0, "i");
    // 5: const 1000001
    loop_vm.emit(OP_CONST, 1000001);
    // 6: cmp_lt (i < 1000001)
    loop_vm.emit(OP_CMP_LT);
    // 7: jz exit (to PC = 17)
    loop_vm.emit(OP_JZ, 17);

    // Loop Body:
    // 8: load sum
    loop_vm.emit(OP_LOAD, 0, "sum");
    // 9: load i
    loop_vm.emit(OP_LOAD, 0, "i");
    // 10: add
    loop_vm.emit(OP_ADD);
    // 11: store sum
    loop_vm.emit(OP_STORE, 0, "sum");

    // 12: load i
    loop_vm.emit(OP_LOAD, 0, "i");
    // 13: const 1
    loop_vm.emit(OP_CONST, 1);
    // 14: add
    loop_vm.emit(OP_ADD);
    // 15: store i
    loop_vm.emit(OP_STORE, 0, "i");

    // 16: jmp 4 (back to header)
    loop_vm.emit(OP_JMP, 4);

    // Exit (PC = 18):
    // 18: load sum
    loop_vm.emit(OP_LOAD, 0, "sum");
    // 19: halt
    loop_vm.emit(OP_HALT);

    printf("  - Compiled Sum(1..1M) program: %zu instructions\n", loop_vm.code.size());

    auto t0 = std::chrono::high_resolution_clock::now();
    i64 loop_cycles = 0;
    i64 sum_res = loop_vm.run(loop_cycles);
    auto t1 = std::chrono::high_resolution_clock::now();

    f64 vm_time_ms = std::chrono::duration<f64, std::milli>(t1 - t0).count();
    f64 mips = ((f64)loop_cycles / (vm_time_ms / 1000.0)) / 1e6;

    printf("  - VM Result: %lld (Expected 500000500000)\n", sum_res);
    printf("  - Executed %lld bytecode instructions in %.2f ms (%.2f MIPS)\n", loop_cycles, vm_time_ms, mips);

    if (sum_res == 500000500000LL) {
        printf("  [PASS] VM execution arithmetic and control flow verified!\n");
    } else {
        printf("  [FAIL] Result mismatch!\n");
    }

    printf("================================================================================\n");
    printf("[VELOC-COMPILER SUCCESS] Micro-Compiler & Bytecode VM Verified!\n");
    printf("================================================================================\n");
    return 0;
}
