module VelocLlm;

#include <veloc.h>
#include <cmath>
#include <vector>
#include <chrono>

struct LlmConfig {
    i32 dim;        // Transformer hidden dimension, e.g. 256
    i32 hidden_dim; // FFN hidden dimension, e.g. 512
    i32 n_layers;   // Number of decoder layers, e.g. 4
    i32 n_heads;    // Number of query heads, e.g. 4
    i32 head_dim;   // dim / n_heads, e.g. 64
    i32 vocab_size; // Vocabulary size, e.g. 1024
    i32 max_seq_len;// Max sequence length, e.g. 128
};

// RMSNorm: x = (x / rms(x)) * weight
void rmsnorm(f32* out, const f32* x, const f32* weight, i32 size) {
    f32 ss = 0.0f;
    for (i32 i = 0; i < size; ++i) {
        ss += x[i] * x[i];
    }
    ss /= (f32)size;
    ss += 1e-5f;
    f32 inv_rms = 1.0f / std::sqrt(ss);
    for (i32 i = 0; i < size; ++i) {
        out[i] = x[i] * inv_rms * weight[i];
    }
}

// Softmax inplace
void softmax(f32* x, i32 size) {
    f32 max_val = x[0];
    for (i32 i = 1; i < size; ++i) {
        if (x[i] > max_val) max_val = x[i];
    }
    f32 sum = 0.0f;
    for (i32 i = 0; i < size; ++i) {
        x[i] = std::exp(x[i] - max_val);
        sum += x[i];
    }
    f32 inv_sum = 1.0f / sum;
    for (i32 i = 0; i < size; ++i) {
        x[i] *= inv_sum;
    }
}

// Matrix vector multiplication: y = W * x, where W is (d_out, d_in)
void matmul(f32* y, const f32* x, const f32* w, i32 d_out, i32 d_in) {
    for (i32 i = 0; i < d_out; ++i) {
        f32 val = 0.0f;
        const f32* w_row = w + i * d_in;
        for (i32 j = 0; j < d_in; ++j) {
            val += w_row[j] * x[j];
        }
        y[i] = val;
    }
}

// RoPE: Rotary Position Embeddings
void apply_rope(f32* q, f32* k, i32 pos, i32 n_heads, i32 head_dim) {
    for (i32 h = 0; h < n_heads; ++h) {
        f32* q_head = q + h * head_dim;
        f32* k_head = k + h * head_dim;
        for (i32 i = 0; i < head_dim; i += 2) {
            f32 freq = 1.0f / std::pow(10000.0f, (f32)i / (f32)head_dim);
            f32 theta = (f32)pos * freq;
            f32 cos_theta = std::cos(theta);
            f32 sin_theta = std::sin(theta);

            f32 q0 = q_head[i];
            f32 q1 = q_head[i + 1];
            q_head[i] = q0 * cos_theta - q1 * sin_theta;
            q_head[i + 1] = q0 * sin_theta + q1 * cos_theta;

            f32 k0 = k_head[i];
            f32 k1 = k_head[i + 1];
            k_head[i] = k0 * cos_theta - k1 * sin_theta;
            k_head[i + 1] = k0 * sin_theta + k1 * cos_theta;
        }
    }
}

class TransformerModel {
public:
    LlmConfig cfg;
    std::vector<f32> token_embedding_table; // (vocab_size, dim)
    std::vector<f32> rms_att_weight;        // (n_layers, dim)
    std::vector<f32> wq, wk, wv, wo;        // (n_layers, dim, dim)
    std::vector<f32> rms_ffn_weight;        // (n_layers, dim)
    std::vector<f32> w1, w2, w3;            // (n_layers, hidden_dim, dim)
    std::vector<f32> rms_final_weight;      // (dim)
    std::vector<f32> wcls;                  // (vocab_size, dim)

    // KV Cache: key_cache, value_cache (n_layers, max_seq_len, dim)
    std::vector<f32> key_cache;
    std::vector<f32> value_cache;

    TransformerModel(const LlmConfig& c) : cfg(c) {
        token_embedding_table.resize(cfg.vocab_size * cfg.dim, 0.01f);
        rms_att_weight.resize(cfg.n_layers * cfg.dim, 1.0f);
        wq.resize(cfg.n_layers * cfg.dim * cfg.dim, 0.02f);
        wk.resize(cfg.n_layers * cfg.dim * cfg.dim, 0.02f);
        wv.resize(cfg.n_layers * cfg.dim * cfg.dim, 0.02f);
        wo.resize(cfg.n_layers * cfg.dim * cfg.dim, 0.02f);

        rms_ffn_weight.resize(cfg.n_layers * cfg.dim, 1.0f);
        w1.resize(cfg.n_layers * cfg.hidden_dim * cfg.dim, 0.02f);
        w2.resize(cfg.n_layers * cfg.dim * cfg.hidden_dim, 0.02f);
        w3.resize(cfg.n_layers * cfg.hidden_dim * cfg.dim, 0.02f);

        rms_final_weight.resize(cfg.dim, 1.0f);
        wcls.resize(cfg.vocab_size * cfg.dim, 0.02f);

        key_cache.resize(cfg.n_layers * cfg.max_seq_len * cfg.dim, 0.0f);
        value_cache.resize(cfg.n_layers * cfg.max_seq_len * cfg.dim, 0.0f);
    }

    i32 forward_step(i32 token, i32 pos) {
        std::vector<f32> x(cfg.dim);
        std::vector<f32> xb(cfg.dim);
        std::vector<f32> q(cfg.dim);
        std::vector<f32> k(cfg.dim);
        std::vector<f32> v(cfg.dim);
        std::vector<f32> att(cfg.max_seq_len);
        std::vector<f32> hb(cfg.hidden_dim);
        std::vector<f32> hb2(cfg.hidden_dim);
        std::vector<f32> logits(cfg.vocab_size);

        // 1. Embedding lookup
        const f32* emb = &token_embedding_table[token * cfg.dim];
        for (i32 i = 0; i < cfg.dim; ++i) x[i] = emb[i];

        // 2. Decoder Layers
        for (i32 l = 0; l < cfg.n_layers; ++l) {
            // Attention RMSNorm
            rmsnorm(xb.data(), x.data(), &rms_att_weight[l * cfg.dim], cfg.dim);

            // Q, K, V projections
            i32 layer_mat_offset = l * cfg.dim * cfg.dim;
            matmul(q.data(), xb.data(), &wq[layer_mat_offset], cfg.dim, cfg.dim);
            matmul(k.data(), xb.data(), &wk[layer_mat_offset], cfg.dim, cfg.dim);
            matmul(v.data(), xb.data(), &wv[layer_mat_offset], cfg.dim, cfg.dim);

            // RoPE
            apply_rope(q.data(), k.data(), pos, cfg.n_heads, cfg.head_dim);

            // Cache Key & Value
            i32 cache_offset = l * cfg.max_seq_len * cfg.dim + pos * cfg.dim;
            for (i32 i = 0; i < cfg.dim; ++i) {
                key_cache[cache_offset + i] = k[i];
                value_cache[cache_offset + i] = v[i];
            }

            // Multi-Head Attention
            std::vector<f32> att_out(cfg.dim, 0.0f);
            f32 scale = 1.0f / std::sqrt((f32)cfg.head_dim);

            for (i32 h = 0; h < cfg.n_heads; ++h) {
                f32* q_h = q.data() + h * cfg.head_dim;
                f32* out_h = att_out.data() + h * cfg.head_dim;

                // Calculate attention scores for timesteps 0..pos
                for (i32 t = 0; t <= pos; ++t) {
                    f32* k_t = &key_cache[l * cfg.max_seq_len * cfg.dim + t * cfg.dim + h * cfg.head_dim];
                    f32 score = 0.0f;
                    for (i32 d = 0; d < cfg.head_dim; ++d) {
                        score += q_h[d] * k_t[d];
                    }
                    att[t] = score * scale;
                }

                // Softmax over timesteps 0..pos
                softmax(att.data(), pos + 1);

                // Weighted sum over values
                for (i32 d = 0; d < cfg.head_dim; ++d) {
                    f32 val = 0.0f;
                    for (i32 t = 0; t <= pos; ++t) {
                        f32* v_t = &value_cache[l * cfg.max_seq_len * cfg.dim + t * cfg.dim + h * cfg.head_dim];
                        val += att[t] * v_t[d];
                    }
                    out_h[d] = val;
                }
            }

            // Output projection
            matmul(xb.data(), att_out.data(), &wo[layer_mat_offset], cfg.dim, cfg.dim);

            // Residual connection: x = x + xb
            for (i32 i = 0; i < cfg.dim; ++i) x[i] += xb[i];

            // FFN RMSNorm
            rmsnorm(xb.data(), x.data(), &rms_ffn_weight[l * cfg.dim], cfg.dim);

            // SwiGLU: w2(SiLU(w1(x)) * w3(x))
            i32 ffn_w13_offset = l * cfg.hidden_dim * cfg.dim;
            matmul(hb.data(), xb.data(), &w1[ffn_w13_offset], cfg.hidden_dim, cfg.dim);
            matmul(hb2.data(), xb.data(), &w3[ffn_w13_offset], cfg.hidden_dim, cfg.dim);

            // SiLU activation: x / (1 + exp(-x))
            for (i32 i = 0; i < cfg.hidden_dim; ++i) {
                f32 silu = hb[i] / (1.0f + std::exp(-hb[i]));
                hb[i] = silu * hb2[i];
            }

            // Down projection w2
            matmul(xb.data(), hb.data(), &w2[l * cfg.dim * cfg.hidden_dim], cfg.dim, cfg.hidden_dim);

            // Residual connection: x = x + xb
            for (i32 i = 0; i < cfg.dim; ++i) x[i] += xb[i];
        }

        // 3. Final RMSNorm
        rmsnorm(x.data(), x.data(), rms_final_weight.data(), cfg.dim);

        // 4. Classifier Head: Logits = wcls * x
        matmul(logits.data(), x.data(), wcls.data(), cfg.vocab_size, cfg.dim);

        // Argmax selection
        i32 next_token = 0;
        f32 best_score = logits[0];
        for (i32 i = 1; i < cfg.vocab_size; ++i) {
            if (logits[i] > best_score) {
                best_score = logits[i];
                next_token = i;
            }
        }
        return next_token;
    }
};

fn main() -> i32 {
    printf("================================================================================\n");
    printf("       VeloC-LLM: Transformer Inference Engine (RoPE, RMSNorm & SwiGLU)         \n");
    printf("================================================================================\n");

    LlmConfig cfg;
    cfg.dim = 128;
    cfg.hidden_dim = 256;
    cfg.n_layers = 4;
    cfg.n_heads = 4;
    cfg.head_dim = cfg.dim / cfg.n_heads;
    cfg.vocab_size = 512;
    cfg.max_seq_len = 128;

    printf("  - Model Config: dim=%d, layers=%d, heads=%d, hidden_dim=%d, vocab=%d\n",
           cfg.dim, cfg.n_layers, cfg.n_heads, cfg.hidden_dim, cfg.vocab_size);

    TransformerModel model(cfg);
    printf("  - Model parameters allocated & initialized\n");

    // Prompt tokens
    i32 current_token = 42;
    i32 tokens_to_generate = 50;

    printf("  - Generating %d tokens autoregressively...\n", tokens_to_generate);
    auto t0 = std::chrono::high_resolution_clock::now();

    for (i32 pos = 0; pos < tokens_to_generate; ++pos) {
        current_token = model.forward_step(current_token, pos);
    }

    auto t1 = std::chrono::high_resolution_clock::now();
    f64 total_time_ms = std::chrono::duration<f64, std::milli>(t1 - t0).count();
    f64 tok_per_sec = ((f64)tokens_to_generate / (total_time_ms / 1000.0));
    f64 ms_per_token = total_time_ms / (f64)tokens_to_generate;

    printf("  - Generated %d tokens in %.2f ms\n", tokens_to_generate, total_time_ms);
    printf("  - Latency: %.2f ms/token\n", ms_per_token);
    printf("  - Throughput: %.1f tokens/sec\n", tok_per_sec);
    printf("  - Final predicted token: %d\n", current_token);

    if (tok_per_sec >= 100.0) {
        printf("  [PASS] Inference throughput exceeds high-performance target (>100 tok/sec)!\n");
    } else {
        printf("  [INFO] Inference completed successfully\n");
    }

    printf("================================================================================\n");
    printf("[VELOC-LLM SUCCESS] Transformer Autoregressive Inference Verified!\n");
    printf("================================================================================\n");
    return 0;
}
