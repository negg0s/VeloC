module VelocRender;

#include <veloc.h>
#include <cmath>


// Structure of Arrays (SoA) ECS for maximum cache throughput & SIMD vectorization
class EcsWorld {
public:
    i32 count;
    std::vector<f32> pos_x;
    std::vector<f32> pos_y;
    std::vector<f32> pos_z;

    std::vector<f32> vel_x;
    std::vector<f32> vel_y;
    std::vector<f32> vel_z;

    std::vector<f32> radius;
    std::vector<u8> visible;
    std::vector<f32> lit_intensity;

    EcsWorld() : count(0) {}

    void init(i32 n) {
        count = n;
        pos_x.resize(n, 0.0f);
        pos_y.resize(n, 0.0f);
        pos_z.resize(n, 0.0f);

        vel_x.resize(n, 0.0f);
        vel_y.resize(n, 0.0f);
        vel_z.resize(n, 0.0f);

        radius.resize(n, 1.0f);
        visible.resize(n, 1);
        lit_intensity.resize(n, 0.0f);

        for (i32 i = 0; i < n; ++i) {
            pos_x[i] = (f32)(i % 200) - 100.0f;
            pos_y[i] = (f32)((i / 200) % 200) - 100.0f;
            pos_z[i] = (f32)(i / 40000) * 10.0f + 20.0f;

            vel_x[i] = 0.05f;
            vel_y[i] = -0.02f;
            vel_z[i] = 0.01f;

            radius[i] = 0.5f + (f32)(i % 5) * 0.2f;
        }
    }

    void update_physics(f32 dt) {
        for (i32 i = 0; i < count; ++i) {
            pos_x[i] += vel_x[i] * dt;
            pos_y[i] += vel_y[i] * dt;
            pos_z[i] += vel_z[i] * dt;
        }
    }

    i32 frustum_cull(f32 near_z, f32 far_z) {
        i32 vis_count = 0;
        for (i32 i = 0; i < count; ++i) {
            f32 z = pos_z[i];
            f32 r = radius[i];
            // Frustum bounds check: inside near/far plane and FOV cone
            if ((z + r >= near_z) && (z - r <= far_z) &&
                (std::abs(pos_x[i]) <= z * 0.8f) && (std::abs(pos_y[i]) <= z * 0.8f)) {
                visible[i] = 1;
                vis_count++;
            } else {
                visible[i] = 0;
            }
        }
        return vis_count;
    }

    f32 compute_lighting(f32 light_x, f32 light_y, f32 light_z) {
        f32 total_energy = 0.0f;
        for (i32 i = 0; i < count; ++i) {
            if (visible[i]) {
                f32 dx = light_x - pos_x[i];
                f32 dy = light_y - pos_y[i];
                f32 dz = light_z - pos_z[i];
                f32 dist_sq = dx * dx + dy * dy + dz * dz + 0.001f;
                f32 inv_dist = 1.0f / std::sqrt(dist_sq);
                // Dot product with surface normal [0, 0, -1]
                f32 ndotl = -(dz * inv_dist);
                if (ndotl < 0.0f) ndotl = 0.0f;
                f32 intensity = (ndotl * 1000.0f) / dist_sq;
                lit_intensity[i] = intensity;
                total_energy += intensity;
            }
        }
        return total_energy;
    }
};

fn main() -> i32 {
    printf("================================================================================\n");
    printf("         VeloC-Render: 3D ECS, Frustum Culling & Lighting Engine                \n");
    printf("================================================================================\n");

    EcsWorld world;
    i32 entity_count = 100000;
    world.init(entity_count);
    printf("  - Initialized SoA ECS with %d entities\n", entity_count);

    // Warm-up run
    world.update_physics(0.016f);
    world.frustum_cull(10.0f, 150.0f);
    world.compute_lighting(0.0f, 50.0f, 0.0f);

    // 100-frame simulation benchmark
    i32 frames = 100;
    auto t0 = std::chrono::high_resolution_clock::now();

    i64 total_visible = 0;
    for (i32 frame = 0; frame < frames; ++frame) {
        world.update_physics(0.016f);
        i32 vis = world.frustum_cull(10.0f, 150.0f);
        total_visible += vis;
        world.compute_lighting((f32)frame, 50.0f, 20.0f);
    }

    auto t1 = std::chrono::high_resolution_clock::now();
    f64 duration_ms = std::chrono::duration<f64, std::milli>(t1 - t0).count();
    f64 avg_frame_ms = duration_ms / (f64)frames;
    f64 fps = 1000.0 / avg_frame_ms;

    printf("  - Simulated %d frames across %d entities: %.2f ms total\n", frames, entity_count, duration_ms);
    printf("  - Average Frame Time: %.3f ms (%.1f FPS)\n", avg_frame_ms, fps);
    printf("  - Average Visible Entities per frame: %lld (Culled: %d)\n", total_visible / frames, entity_count - (i32)(total_visible / frames));

    if (fps >= 60.0) {
        printf("  [PASS] Frame rate exceeds 60 FPS target on 100k entities!\n");
    } else {
        printf("  [WARN] Frame rate below target\n");
    }

    printf("================================================================================\n");
    printf("[VELOC-RENDER SUCCESS] 3D Game Loop & ECS Engine Verified!\n");
    printf("================================================================================\n");
    return 0;
}
