fn main() -> i32 {
    f32 a[8] = {1, 2, 3, 4, 5, 6, 7, 8};
    f32 b[8] = {2, 2, 2, 2, 2, 2, 2, 2};
    f32 c[8] = {10, 10, 10, 10, 10, 10, 10, 10};
    f32 out[8];
    for (int i = 0; i < 8; i++) {
        out[i] = a[i] * b[i] + c[i];
    }
    printf("FMA[0]: %.1f, FMA[7]: %.1f\n", out[0], out[7]);
    return 0;
}
